<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RealtimeTranslate.Core\RealtimeTranslate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="dictionary.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\word-cards.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\MORPHYNET-NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Product>Realtime Translate Codex</Product>
    <Description>Compact Windows OCR word lookup and AI text explanation overlay.</Description>
    <Authors>WhoAlwaysZzz</Authors>
    <RepositoryUrl>https://github.com/WhoAlwaysZzz/realtime-translate-codex</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
